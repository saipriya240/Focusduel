{
  "name": "UserProfile",
  "type": "object",
  "properties": {
    "username": {
      "type": "string",
      "description": "Unique handle used for search and leaderboards"
    },
    "display_name": {
      "type": "string"
    },
    "avatar_url": {
      "type": "string"
    },
    "bio": {
      "type": "string"
    },
    "focus_personality": {
      "type": "string",
      "enum": [
        "night_owl",
        "early_bird",
        "silent_assassin",
        "comeback_king"
      ],
      "description": "Focus archetype chosen during onboarding"
    },
    "daily_target_minutes": {
      "type": "number",
      "default": 120
    },
    "preferred_session_minutes": {
      "type": "number",
      "default": 25
    },
    "productivity_category": {
      "type": "string",
      "enum": [
        "deep_work",
        "study",
        "building",
        "creative",
        "admin"
      ],
      "description": "Default focus category"
    },
    "timezone": {
      "type": "string",
      "rls": {
        "read": {
          "$or": [
            {
              "created_by_id": "{{user.id}}"
            },
            {
              "user_condition": {
                "role": "admin"
              }
            }
          ]
        }
      }
    },
    "notifications_enabled": {
      "type": "boolean",
      "default": true
    },
    "battle_invites_enabled": {
      "type": "boolean",
      "default": true
    },
    "activity_visibility": {
      "type": "string",
      "enum": [
        "friends",
        "public",
        "private"
      ],
      "description": "Who can see this player's activity feed entries"
    },
    "public_roasts": {
      "type": "boolean",
      "default": true
    },
    "xp": {
      "type": "number",
      "default": 0
    },
    "level": {
      "type": "number",
      "default": 1
    },
    "rank_title": {
      "type": "string",
      "default": "Contender"
    },
    "streak": {
      "type": "number",
      "default": 0
    },
    "longest_streak": {
      "type": "number",
      "default": 0
    },
    "last_session_date": {
      "type": "string",
      "description": "Local date key (YYYY-MM-DD) of last completed session"
    },
    "last_goal_bonus_date": {
      "type": "string",
      "description": "Date key of the last daily-goal XP bonus"
    },
    "total_focus_seconds": {
      "type": "number",
      "default": 0
    },
    "sessions_completed": {
      "type": "number",
      "default": 0
    },
    "battles_won": {
      "type": "number",
      "default": 0
    },
    "battles_lost": {
      "type": "number",
      "default": 0
    },
    "win_streak": {
      "type": "number",
      "default": 0
    },
    "onboarding_complete": {
      "type": "boolean",
      "default": false
    }
  },
  "required": [
    "username"
  ],
  "rls": {
    "read": {},
    "create": {
      "created_by_id": "{{user.id}}"
    },
    "update": {
      "created_by_id": "{{user.id}}"
    },
    "delete": {
      "created_by_id": "{{user.id}}"
    }
  }
}